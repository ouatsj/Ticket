# Copier vers .env (ne jamais committer .env)
PORT=8091
TZ=Europe/Berlin

# Lecture DB Ticket (mêmes valeurs que application/config/database.php — ne pas coller de secrets ici)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secrets API (générer : openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# CORS — origines Flutter web / debug
CORS_ORIGINS=http://localhost:*

# Firebase / FCM (Phase 5) — JSON service account serveur uniquement
# FIREBASE_SERVICE_ACCOUNT=/var/secrets/tei-firebase.json
# Sans fichier : FCM_MOCK=1 journalise les push (alertes restent en base)
FCM_MOCK=1
