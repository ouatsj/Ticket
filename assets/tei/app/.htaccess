<Files "version.json">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# APK : pas d'accès direct — téléchargement via Home/download_apk (admin uniquement).
<FilesMatch "\.(apk)$">
  Require all denied
</FilesMatch>
# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(apk)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
